{
  "name": "Poll",
  "type": "object",
  "properties": {
    "question": { "type": "string" },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": { "type": "string" },
          "votes": { "type": "number", "default": 0 }
        },
        "required": ["text"]
      }
    },
    "author_name": { "type": "string" },
    "voter_ids": { "type": "array", "items": { "type": "string" } }
  },
  "required": ["question", "options"],
  "rls": {
    "read": {},
    "create": { "created_by_id": "{{user.id}}" },
    "update": {},
    "delete": { "created_by_id": "{{user.id}}" }
  }
}
