{
  "name": "Product",
  "type": "object",
  "properties": {
    "brand": {"type": "string"},
    "category": {"type": "string", "enum": ["Makeup","Fragrance","Skincare","Haircare","Body","Nails","Devices","Intimate Care","Tools","Cosmetic Bags & Cases","Men's","Pet Care"]},
    "curator_product": {"type": "boolean", "default": false, "title": "Curated by The Muse (artisan pick)"},
    "currency": {"type": "string", "default": "USD"},
    "current_price": {"type": "number", "title": "Last verified price at a retailer"},
    "description": {"type": "string"},
    "expiry_date": {"type": "string", "format": "date"},
    "fallback_image_url": {"type": "string", "title": "Web-fetched backup image URL"},
    "featured": {"type": "boolean", "default": false, "title": "Featured on public profile"},
    "image_status": {"type": "string", "enum": ["pending","verified","missing"], "default": "pending", "title": "Product image fetch status"},
    "image_url": {"type": "string"},
    "in_shopping_list": {"type": "boolean", "default": false},
    "in_vanity": {"type": "boolean", "default": false},
    "in_wishlist": {"type": "boolean", "default": false},
    "ingredients": {"type": "string"},
    "is_profile_visible": {"type": "boolean", "default": false, "title": "Shared with the community"},
    "last_price_checked": {"type": "string", "format": "date-time"},
    "last_sale_price": {"type": "number"},
    "lowest_price": {"type": "number", "title": "Lowest verified price, in the size recorded below"},
    "muse_shimmer": {"type": "string"},
    "name": {"type": "string"},
    "on_sale": {"type": "boolean", "default": false, "title": "A verified drop against the price we saw before"},
    "order_ref": {"type": "string", "title": "Checkout reference for this purchase"},
    "price": {"type": "number", "title": "Your own reference price"},
    "price_alert_active": {"type": "boolean", "default": true},
    "purchased": {"type": "boolean", "default": false, "title": "Bought through the in-app checkout"},
    "purchased_at": {"type": "string", "format": "date-time", "title": "When it was bought"},
    "rating": {"type": "number"},
    "review_count": {"type": "number"},
    "sale_discount_pct": {"type": "number"},
    "scan_method": {"type": "string"},
    "shade": {"type": "string"},
    "shopping_qty": {"type": "number", "default": 1},
    "source_url": {"type": "string"},
    "subcategory": {"type": "string"},
    "tags": {"type": "array", "items": {"type": "string", "enum": ["daily use","travel","wishlist"]}},
    "watch_checked_at": {"type": "string", "format": "date-time", "title": "When the price below was read"},
    "watch_retailer": {"type": "string", "title": "The retailer that price came from"},
    "watch_size": {"type": "string", "title": "The size the listing stated, so only like is compared with like"},
    "watch_url": {"type": "string", "title": "The listing itself, so any drop can be checked"},
    "where_to_buy": {"type": "string"}
  },
  "required": ["brand", "name", "category"],
  "rls": {
    "create": {"created_by_id": "{{user.id}}"},
    "delete": {"$or": [{"created_by_id": "{{user.id}}"}, {"user_condition": {"role": "admin"}}]},
    "read": {"$or": [
      {"created_by_id": "{{user.id}}"},
      {"data.is_profile_visible": true},
      {"$and": [{"data.curator_product": true}, {"created_by_id": "6a57507f2558691b9c2c4bd0"}]},
      {"user_condition": {"role": "admin"}}
    ]},
    "update": {"created_by_id": "{{user.id}}"}
  }
}
