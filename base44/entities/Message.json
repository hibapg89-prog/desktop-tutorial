{
  "name": "Message",
  "type": "object",
  "properties": {
    "sender_id": { "type": "string" },
    "recipient_id": { "type": "string" },
    "body": { "type": "string" },
    "image_url": { "type": "string" },
    "read": { "type": "boolean", "default": false }
  },
  "required": ["sender_id", "recipient_id"],
  "rls": {
    "read": { "$or": [{ "data.sender_id": "{{user.id}}" }, { "data.recipient_id": "{{user.id}}" }] },
    "create": { "data.sender_id": "{{user.id}}" },
    "update": { "data.recipient_id": "{{user.id}}" },
    "delete": { "$or": [{ "data.sender_id": "{{user.id}}" }, { "data.recipient_id": "{{user.id}}" }] }
  }
}
