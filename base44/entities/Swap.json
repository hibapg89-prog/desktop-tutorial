{
  "name": "Swap",
  "type": "object",
  "properties": {
    "offered_product_name": { "type": "string" },
    "offered_brand": { "type": "string" },
    "offered_shade": { "type": "string" },
    "offered_category": { "type": "string" },
    "offered_image_url": { "type": "string" },
    "looking_for": { "type": "string" },
    "author_name": { "type": "string" },
    "status": { "type": "string", "enum": ["open", "matched", "closed"], "default": "open" }
  },
  "required": ["offered_product_name", "looking_for"],
  "rls": {
    "read": {},
    "create": { "created_by_id": "{{user.id}}" },
    "update": { "created_by_id": "{{user.id}}" },
    "delete": { "created_by_id": "{{user.id}}" }
  }
}
